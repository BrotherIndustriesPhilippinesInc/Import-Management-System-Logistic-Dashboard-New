@model LogisticDashboard.Core.ImportPICInformation

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>ImportPICInformation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ModeOfShipment" class="control-label"></label>
                <input asp-for="ModeOfShipment" class="form-control" />
                <span asp-validation-for="ModeOfShipment" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Supplier" class="control-label"></label>
                <input asp-for="Supplier" class="form-control" />
                <span asp-validation-for="Supplier" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ShippingMainPICStaff" class="control-label"></label>
                <input asp-for="ShippingMainPICStaff" class="form-control" />
                <span asp-validation-for="ShippingMainPICStaff" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ShippingSubPICStaff" class="control-label"></label>
                <input asp-for="ShippingSubPICStaff" class="form-control" />
                <span asp-validation-for="ShippingSubPICStaff" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Supervisor" class="control-label"></label>
                <input asp-for="Supervisor" class="form-control" />
                <span asp-validation-for="Supervisor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedBy" class="control-label"></label>
                <input asp-for="CreatedBy" class="form-control" readonly/>
                <span asp-validation-for="CreatedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedDate" class="control-label"></label>
                <input type="text"
                       class="form-control"
                       value="@Model.CreatedDate.ToLocalTime().ToString("MM/dd/yyyy hh:mm:ss tt")"
                       readonly />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UpdatedBy" class="control-label"></label>
                <input id="UpdatedBy" asp-for="UpdatedBy" class="form-control" readonly/>
                <span asp-validation-for="UpdatedBy" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="UpdatedDate" class="control-label"></label>
                <input asp-for="UpdatedDate" class="form-control" />
                <span asp-validation-for="UpdatedDate" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Assume you saved the user's name in localStorage as 'username'
        const storedUser = localStorage.getItem("user");
        let JSONstoredUser = JSON.parse(storedUser);
        if (storedUser) {
            document.getElementById("UpdatedBy").value = JSONstoredUser.employeeNumber;
        }
    });


</script>